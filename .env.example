# Environment variables for Job Tracker Pro

# Database connection (PostgreSQL)
# When running locally with Docker Postgres exposed on port 5434:
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/job_tracker?schema=public"

# When running both app and db inside Docker network:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/job_tracker?schema=public"

# App Configuration
PORT=4000
NODE_ENV=development
APP_URL="http://localhost:4000"

# Job Ingestion & Auto-sync Configuration
JOB_SYNC_INTERVAL_MINUTES=60
AUTO_SYNC_ENABLED=true
