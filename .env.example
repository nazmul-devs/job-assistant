# ==============================================================================
# Job Assistant Pro — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database (Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=job_tracker

# Host port for Postgres (default: 5434, bound only to 127.0.0.1 on VPS for security)
DB_PORT=5434

# Prisma database URL:
# - Inside Docker network:
DATABASE_URL="postgresql://postgres:postgres_secure_pass@postgres:5432/job_tracker?schema=public"
# - Local host machine development (outside Docker):
# DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5434/job_tracker?schema=public"

# ------------------------------------------------------------------------------
# Web Application Configuration
# ------------------------------------------------------------------------------
# Port exposed on VPS host (default: 80 for direct web access, or 4000/3000)
PORT=80
NODE_ENV=production
APP_URL="http://localhost"

# Security token for triggering cron endpoints (/api/cron/sync)
CRON_SECRET=job_assistant_secret_token_change_me

# Optional domain name for automatic Let's Encrypt SSL with Caddy
DOMAIN=

# ------------------------------------------------------------------------------
# Job Ingestion & Auto-sync Configuration
# ------------------------------------------------------------------------------
AUTO_SYNC_ENABLED=true
JOB_SYNC_INTERVAL_MINUTES=60
